{
  "description": "Maestro liaison continuity and bounded-context enforcement. SessionStart restores posture and durable state; after compact it injects the same-thread continuity handoff. PreToolUse warns on context-heavy reads/runs and denies only an explicit new_context call that lacks a fresh rollover handoff. Forced automatic compaction is never blocked. Stop blocks blind turn-ends within a bounded budget.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}/hooks/scripts/sessionstart-digest.sh\"",
            "timeout": 15,
            "additionalContextLimit": 12500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}/hooks/scripts/pretool-warn.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^new_context$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}/hooks/scripts/precontext-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}/hooks/scripts/stop-guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
